dnl knotify: the PulseAudio player (kpulseplayer.cpp, kpulsemainloop.cpp)
dnl needs libpulse and libsndfile. It is optional: without them knotify
dnl plays sounds only with an external player.

AC_ARG_WITH(pulseaudio,
  AC_HELP_STRING([--without-pulseaudio],[build knotify without its PulseAudio player [default=detect]]),
  [with_pulseaudio=$withval], [with_pulseaudio=check])

have_knotify_pulse=no
if test "x$with_pulseaudio" != "xno"; then
  KDE_PKG_CHECK_MODULES(KNOTIFY_PULSE, [libpulse >= 0.9.16 sndfile >= 1.0.20],
    [have_knotify_pulse=yes], [have_knotify_pulse=no])
  if test "x$have_knotify_pulse" = "xyes"; then
    AC_DEFINE(HAVE_PULSEAUDIO, 1, [Define if knotify plays sounds with libpulse and libsndfile])
  elif test "x$with_pulseaudio" = "xyes"; then
    AC_MSG_ERROR([--with-pulseaudio given, but libpulse >= 0.9.16 or sndfile >= 1.0.20 was not found])
  fi
fi
AC_SUBST(KNOTIFY_PULSE_CFLAGS)
AC_SUBST(KNOTIFY_PULSE_LIBS)
AM_CONDITIONAL(include_knotify_pulse, test "x$have_knotify_pulse" = "xyes")
